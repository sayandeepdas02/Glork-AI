# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# Rotate all secrets if they have ever been exposed.

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/glork
REDIS_URL=redis://HOST:6379/0

# Generate: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

RETELL_API_KEY=key_REPLACE
RETELL_WEBHOOK_SECRET=whsec_REPLACE

GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/v1/calendar/callback

TWILIO_ACCOUNT_SID=ACREPLACE
TWILIO_AUTH_TOKEN=REPLACE
TWILIO_PHONE_NUMBER=+1REPLACE

SENDGRID_API_KEY=SG.REPLACE
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
BACKEND_URL=https://YOUR_BACKEND_DOMAIN
ENVIRONMENT=production
ALLOWED_ORIGINS=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
